<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Model library, sounds and logs live in /sdcard/OpenAX12 on the radio (API 28).
         From API 30 on the app falls back to its own external files dir, no permission needed. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- RadioService keeps the radio link, runtime engine and audio alive in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Typed foreground-service permission, only exists from API 34 (ignored on the radio).
         The service type is mediaPlayback, see RadioService and docs/ASSUMPTIONS.md (a1). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Runtime permission from API 33; requested only behind an SDK_INT check. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Normal permission (no prompt): closes the stock RadioMaster app's background process, which
         otherwise holds the radio's serial port. See StockApp. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- Normal permission: "Start open-ax12 when the radio boots" (BootReceiver). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Package visibility (API 30+): detecting the installed text-to-speech engine. -->
    <queries>
        <!-- Package visibility (API 30+): is the stock RadioMaster app installed? -->
        <package android:name="com.Flyshark.RadioMasterAX" />
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".OpenAx12App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenAx12">

        <!-- singleTask: a shared .oax12 file arrives in the running instance (onNewIntent).
             adjustNothing: the soft keyboard must not resize the fixed 853x480 dp canvas. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Open a model archive from a file manager or another app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <!-- File managers that send no useful MIME type: match the extension. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.oax12" />
                <data android:pathPattern=".*\\..*\\.oax12" />
                <data android:pathPattern=".*\\..*\\..*\\.oax12" />
            </intent-filter>

            <!-- Receive a shared model archive. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- Foreground service type: mediaPlayback (available from API 29, the attribute is
             ignored on API 28). The service keeps voice, vario tones and the radio link alive. -->
        <service
            android:name=".RadioService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Starts the app after the radio booted when the setting is on; the receiver checks the
             setting itself. BOOT_COMPLETED is a protected broadcast, only the system sends it. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- The FileProvider for export / share is declared by :core:data
             (authority <applicationId>.openax12.files) and merged into this manifest. -->
    </application>

</manifest>
